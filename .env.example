# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Gemini
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_QUALITY_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image
# Keep image work conservative; Veo has its own higher worker concurrency below.
GEMINI_IMAGE_MAX_CONCURRENCY=1
GEMINI_IMAGE_RETRY_ATTEMPTS=5
GEMINI_IMAGE_RETRY_BASE_SECONDS=4
GEMINI_IMAGE_RETRY_MAX_SECONDS=45
CINEMIND_ENABLE_IMAGE_GENERATION=true
CINEMIND_ENABLE_QUALITY_GATE=true

# Veo
# Visual/reference renderer (fast + reference/first-last-frame capable)
VEO_MODEL=veo-3.1-fast-generate-001
VEO_VISUAL_MODEL=veo-3.1-fast-generate-001
# Native-audio renderer. Current Agent Platform capability tables expose sound on Lite.
# Override this when native audio is enabled on another Veo endpoint in your project.
VEO_AUDIO_MODEL=veo-3.1-lite-generate-001
VEO_LOCATION=us-central1
VEO_DURATION_SECONDS=8
VEO_POLL_SECONDS=5

# Local render workers may prepare several shots concurrently, but Vertex has a
# separate long-running prediction quota. Keep only a small adaptive number of
# Veo LROs active at once; the runtime reduces this automatically after a 429.
VEO_MAX_CONCURRENCY=6
VEO_LRO_MAX_INFLIGHT=2
VEO_SUBMIT_RETRY_ATTEMPTS=8
VEO_RETRY_BASE_SECONDS=8
VEO_RETRY_MAX_SECONDS=90
VEO_SUCCESSES_BEFORE_PROBE=4
VEO_OPERATION_TIMEOUT_SECONDS=900

CINEMIND_ENABLE_VIDEO_GENERATION=false
CINEMIND_VIDEO_GCS_URI=gs://your-bucket/cinemind/videos

# Long-form orchestration
CINEMIND_SYNC_PREVIEW_MAX_SECONDS=96
CINEMIND_LONG_FORM_MAX_SECONDS=1800
CINEMIND_MAX_PARALLEL_SCENES=3

# External TTS is intentionally OFF in the primary production path.
CINEMIND_ENABLE_TTS=false
GEMINI_TTS_MODEL=gemini-2.5-flash-tts
GEMINI_TTS_VOICE=Kore

# ClickHouse Cloud — use a dedicated least-privilege user
CLICKHOUSE_HOST=your-host.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=cinemind_agent
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_ALLOW_WRITE_ACCESS=true
CLICKHOUSE_ALLOW_DROP=false
CLICKHOUSE_ENABLED=true
